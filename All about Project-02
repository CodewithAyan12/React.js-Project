1.card.jsx- in card.t jsx we have the UI of one single card so first we create how one card gona look 
 code - import React from "react";

const Card = (props) => {

    const {title, heading, count} = props ;

    // ==================== UI ===========================
    return(
        <section className="card-section">
            <p>{title}</p>
            <h2 className="text-3xl">{heading}</h2>
            <p>{count} openings</p>
        </section>
    );
}


export default Card ;

