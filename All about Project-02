2.cardSection.jsx- after creating one single card we have to create multiple card so we create this section for it in this section 
 i iterate all the Array that using map like -import React from 'react'
import Card from './Card'

import {CardDetails} from '../../resources/CardData'

const CardSection = () => {

    return (
        <div className="w-[80%] flex flex-wrap gap-4">
            {CardDetails && CardDetails.map(eachElement => {
                return <Card key={eachElement.id} title={eachElement.title} heading={eachElement.heading} count={eachElement.count}  />
            })}
        </div>
    )
}

export default CardSection
 =============code-Explanation=============
